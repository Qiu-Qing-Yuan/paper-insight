{
  "framework": "vite",
  "buildCommand": "node scripts/export-data.js && cd client && npm run build",
  "outputDirectory": "client/dist",
  "installCommand": "npm install && cd client && npm install",
  "functions": {
    "api/papers.js": { "includeFiles": "client/public/data/papers.json" },
    "api/filters.js": { "includeFiles": "client/public/data/papers.json" }
  },
  "headers": [
    {
      "source": "/data/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
